# Copy to .env and export locally. The CLI reads environment variables, not .env files.
DATABASE_URL=postgresql+psycopg://revenue:CHANGE_ME@localhost:5432/revenue_leakage
TEST_DATABASE_URL=postgresql+psycopg://revenue:CHANGE_ME@localhost:5432/revenue_leakage_test
# Used only by optional docker-compose.yml; match DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME
DATA_DIR=data/synthetic
LOAD_BATCH_SIZE=1000
ANALYTICS_AS_OF=2025-12-31
PG_STATEMENT_TIMEOUT_MS=120000
PG_LOCK_TIMEOUT_MS=10000
# ETL snapshots require a producer-assigned monotonically increasing --snapshot-version.
ETL_SOURCE=financials
ETL_MODE=incremental
ETL_MAX_ATTEMPTS=3
ETL_RETRY_DELAY_SECONDS=0.5
ETL_MAX_DATA_AGE_DAYS=45
ETL_MAX_RUN_AGE_SECONDS=86400
